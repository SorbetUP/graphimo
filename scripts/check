#!/usr/bin/env python3
"""Run Graphimo's local verification gate."""

from __future__ import annotations

import argparse
import ast
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from collections.abc import Iterable
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def run(label: str, *command: str, env: dict[str, str] | None = None) -> None:
    print(f"\n== {label} ==", flush=True)
    subprocess.run(command, cwd=ROOT, env=env, check=True)


def require(command: str, explanation: str) -> str:
    located = shutil.which(command)
    if located is None:
        raise SystemExit(f"Missing required command '{command}': {explanation}")
    return located


def check_dependencies(mode: str) -> None:
    try:
        import pytest  # noqa: F401
        import ruff  # noqa: F401
    except ImportError as exc:
        raise SystemExit(
            "Install Graphimo development dependencies first: "
            "python -m pip install -e '.[dev,notebook]'"
        ) from exc

    if mode == "full":
        if not discover_addons():
            raise SystemExit("Full gate requires at least one addon distribution under addons/.")
        try:
            import marimo
            import torch
            import torchlens
        except ImportError as exc:
            raise SystemExit(
                "Full gate requires marimo, PyTorch and TorchLens. Install the project extras "
                "and the graphimo-pytorch addon first."
            ) from exc
        if not torch.__version__:
            raise SystemExit("PyTorch did not report a version.")
        if marimo.__version__ != "0.25.2":
            raise SystemExit(f"Full gate requires marimo==0.25.2; found {marimo.__version__}.")
        if torchlens.__version__ != "2.34.1":
            raise SystemExit(
                f"Full gate requires torchlens==2.34.1; found {torchlens.__version__}."
            )


def discover_addons() -> list[Path]:
    """Every addon distribution under addons/, discovered without hardcoding."""
    addons_root = ROOT / "addons"
    if not addons_root.is_dir():
        return []
    return sorted(child for child in addons_root.iterdir() if (child / "pyproject.toml").is_file())


def addon_package_dir(addon: Path) -> Path | None:
    """The importable package directory of an addon (e.g. graphimo_pytorch/)."""
    package_dir = next(addon.glob("*/__init__.py"), None)
    return package_dir.parent if package_dir is not None else None


def addon_package_names() -> list[str]:
    """Read each discovered addon's distribution name from its pyproject.toml."""
    names = []
    for addon in discover_addons():
        text = (addon / "pyproject.toml").read_text(encoding="utf-8")
        match = re.search(r'^name\s*=\s*"([^"]+)"', text, re.MULTILINE)
        if match:
            names.append(match.group(1))
    return names


def addon_module_names() -> list[str]:
    """Importable top-level package names of the discovered addons."""
    names = []
    for addon in discover_addons():
        package_dir = addon_package_dir(addon)
        if package_dir is not None:
            names.append(package_dir.name)
    return names


def python_paths() -> list[str]:
    paths = [
        "adapter",
        "core",
        "components",
        "examples",
        "graphimo",
        "graphimo/service",
        "tests",
    ]
    for addon in discover_addons():
        package_dir = addon_package_dir(addon)
        if package_dir is not None:
            paths.append(str(package_dir.relative_to(ROOT)))
        if (addon / "tests").is_dir():
            paths.append(str((addon / "tests").relative_to(ROOT)))
    return [path for path in paths if path]


def lint_paths() -> list[str]:
    paths = [
        "adapter",
        "components",
        "examples",
        "graphimo",
        "core/graphimo_core",
        "tests/test_core_vertical_slice.py",
        "tests/test_groups.py",
        "tests/test_service.py",
        "tests/test_kernel_publisher.py",
        "tests/test_luau_plugin_adapter.py",
        "tests/test_artifact_api.py",
        "tests/test_base_block_contract.py",
        "tests/test_core_without_torch.py",
        "tests/test_component_parameter_metadata.py",
        "tests/test_dispatch_contract.py",
        "tests/test_graph_scopes.py",
        "tests/test_instance_source.py",
        "tests/test_live_node_ports.py",
        "tests/test_live_pytorch_restore.py",
        "tests/test_live_capture_output.py",
        "tests/test_artifact_catalogue.py",
        "tests/test_verifier.py",
        "tests/test_node_contract.py",
        "tests/test_metablock_host.py",
        "tests/test_package_distribution.py",
        "scripts/check",
        "scripts/check_dependencies.py",
        "scripts/pre-commit",
    ]
    for addon in discover_addons():
        package_dir = addon_package_dir(addon)
        if package_dir is not None:
            paths.append(str(package_dir.relative_to(ROOT)))
        tests_dir = addon / "tests"
        if tests_dir.is_dir():
            for test_file in sorted(tests_dir.glob("test_*.py")):
                paths.append(str(test_file.relative_to(ROOT)))
        dist_test = ROOT / "tests" / f"test_{addon.name}_addon_distribution.py"
        if dist_test.is_file():
            paths.append(str(dist_test.relative_to(ROOT)))
    return [path for path in paths if path]


def generated_artifacts() -> set[str]:
    """Return generated build paths currently present in the repository."""
    artifacts: set[str] = set()
    pruned = {".git", ".venv", "node_modules", "__pycache__", ".pytest_cache", ".ruff_cache"}
    for directory, child_dirs, files in os.walk(ROOT):
        child_dirs[:] = [name for name in child_dirs if name not in pruned]
        current = Path(directory)
        for name in (*child_dirs, *files):
            path = current / name
            if name in {"build", "dist"} or name.endswith(".egg-info"):
                artifacts.add(path.relative_to(ROOT).as_posix())
                if path.is_dir():
                    artifacts.update(
                        child.relative_to(ROOT).as_posix() for child in path.rglob("*")
                    )
    return artifacts


def tracked_generated_artifacts(git: str) -> list[str]:
    result = subprocess.run([git, "ls-files", "-z"], cwd=ROOT, capture_output=True, check=True)
    tracked = result.stdout.decode().split("\0")
    return [
        path
        for path in tracked
        if path
        and any(
            part in {"build", "dist"} or part.endswith(".egg-info") for part in Path(path).parts
        )
    ]


def verify_generated_artifact_hygiene(before: set[str], *, baseline_tracked: Iterable[str]) -> None:
    tracked = list(baseline_tracked)
    if tracked:
        raise SystemExit(
            "Generated package artifacts must not be tracked by Git:\n- " + "\n- ".join(tracked)
        )
    created = sorted(generated_artifacts() - before)
    if created:
        raise SystemExit(
            "The verification gate created build artifacts in the repository; build outputs "
            "must stay in temporary directories:\n- " + "\n- ".join(created)
        )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--fast", action="store_true", help="run the fast local gate")
    group.add_argument("--full", action="store_true", help="run the pre-push gate")
    group.add_argument(
        "--e2e", action="store_true", help="run only the live-kernel end-to-end tests"
    )
    group.add_argument(
        "--stress",
        action="store_true",
        help="run mutation-reliability, verifier and fuzz tests only",
    )
    group.add_argument(
        "--release",
        action="store_true",
        help="run every applicable gate (like --full) plus packaging",
    )
    args = parser.parse_args()
    selected = next(flag for flag, value in vars(args).items() if value)
    mode = {"fast": "fast", "full": "full", "e2e": "e2e", "stress": "stress", "release": "full"}[
        selected
    ]
    check_dependencies(mode)

    git = require("git", "run the local verification gate from a Git checkout")
    tracked_artifacts = tracked_generated_artifacts(git)
    artifact_baseline = generated_artifacts()

    ruff = require("ruff", "install the 'dev' extra")
    py_paths = python_paths()
    checked_paths = lint_paths()
    run("Python syntax/import sanity", sys.executable, "-m", "compileall", "-q", *py_paths)
    run("Ruff format", ruff, "format", "--check", *checked_paths)
    run("Ruff lint", ruff, "check", *checked_paths)

    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    env["GRAPHIMO_TEST_BOOTSTRAP"] = "1" if args.full else "0"
    marimo_python = subprocess.run(
        [sys.executable, "-c", "import sys, marimo; print(sys.executable)"],
        cwd=ROOT,
        capture_output=True,
        text=True,
        check=False,
    )
    if marimo_python.returncode == 0:
        env["GRAPHIMO_MARIMO_PYTHON"] = marimo_python.stdout.strip()
    if mode == "full":
        require("luau", "install the Luau CLI for live Graphimo bridge tests")
        luau_compile = require(
            "luau-compile", "install the Luau compiler for plugin adapter syntax checks"
        )
        luau_files = sorted(
            str(path.relative_to(ROOT)) for path in (ROOT / "plugin").glob("*.luau")
        )
        if not luau_files:
            raise SystemExit("No Zeron plugin Luau files found under plugin/.")
        run("Zeron plugin Luau syntax (all files)", luau_compile, "--only-parse", *luau_files)
        manifest_path = ROOT / "plugin" / "zeron-plugin.json"
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if not isinstance(manifest.get("tools"), list) or not manifest["tools"]:
            raise SystemExit("zeron-plugin.json must declare a non-empty tools array")
        for tool in manifest["tools"]:
            if not isinstance(tool.get("name"), str) or not isinstance(tool.get("input"), dict):
                raise SystemExit(f"zeron-plugin.json tool is malformed: {tool!r}")
        print(f"Zeron plugin manifest OK ({len(manifest['tools'])} tools).", flush=True)

    with tempfile.TemporaryDirectory(prefix="graphimo-check-") as temporary:
        if mode == "full":
            build_root = Path(temporary) / "source"
            shutil.copytree(
                ROOT,
                build_root,
                ignore=shutil.ignore_patterns(
                    ".git",
                    ".venv",
                    ".pytest_cache",
                    ".ruff_cache",
                    ".marimo",
                    ".mypy_cache",
                    ".tox",
                    "node_modules",
                    "__pycache__",
                    "build",
                    "dist",
                    "*.egg-info",
                ),
            )
            wheelhouse = Path(temporary) / "wheels"
            wheelhouse.mkdir()
            run(
                "Root wheel build",
                sys.executable,
                "-m",
                "pip",
                "wheel",
                "--no-deps",
                "--no-build-isolation",
                str(build_root),
                "-w",
                str(wheelhouse),
            )
            addons = discover_addons()
            for addon in addons:
                run(
                    f"Addon wheel build: {addon.name}",
                    sys.executable,
                    "-m",
                    "pip",
                    "wheel",
                    "--no-deps",
                    "--no-build-isolation",
                    str(build_root / "addons" / addon.name),
                    "-w",
                    str(wheelhouse),
                )
            install_target = Path(temporary) / "install"
            install_target.mkdir()
            for wheel in sorted(wheelhouse.glob("*.whl")):
                run(
                    f"Isolated install: {wheel.name}",
                    sys.executable,
                    "-m",
                    "pip",
                    "install",
                    "--no-deps",
                    "--target",
                    str(install_target),
                    str(wheel),
                )
            # Clean-environment origin check: with the repo NOT on sys.path and
            # cwd outside the checkout, every distribution must import from the
            # isolated install target, proving the wheels are self-contained.
            module_names = ["graphimo", *addon_module_names()]
            origin_probe = (
                "import sys; "
                "names = %r; "
                "print('GRAPHIMO_ORIGIN:' + repr({n: __import__(n).__file__ for n in names}))"
                % (module_names,)
            )
            origin_env = {
                "PATH": os.environ.get("PATH", ""),
                "HOME": os.environ.get("HOME", ""),
                "PYTHONPATH": str(install_target),
                "PYTHONDONTWRITEBYTECODE": "1",
            }
            probe = subprocess.run(
                [sys.executable, "-s", "-c", origin_probe],
                cwd=temporary,
                env=origin_env,
                capture_output=True,
                text=True,
                check=False,
            )
            if probe.returncode != 0:
                raise SystemExit(
                    "Clean-environment wheel import failed:\n" + probe.stdout + probe.stderr
                )
            marker = "GRAPHIMO_ORIGIN:"
            if marker not in probe.stdout:
                raise SystemExit("Clean-environment wheel import produced no origin report.")
            origins = ast.literal_eval(probe.stdout.split(marker, 1)[1].splitlines()[0])
            for package_name, module_file in origins.items():
                if not str(module_file).startswith(str(install_target)):
                    raise SystemExit(
                        f"Package {package_name!r} imported from {module_file}, not from the "
                        f"isolated install {install_target}; the wheel is not self-contained."
                    )
            print(
                "Clean-environment wheel origins OK: "
                + ", ".join(f"{name} -> install dir" for name in origins),
                flush=True,
            )
            existing_pythonpath = env.get("PYTHONPATH", "")
            env["PYTHONPATH"] = os.pathsep.join(
                part
                for part in [
                    str(install_target),
                    str(ROOT),
                    str(ROOT / "core"),
                    existing_pythonpath,
                ]
                if part
            )
            run(
                "Graphimo dependency consistency",
                sys.executable,
                "scripts/check_dependencies.py",
                "graphimo",
                *addon_package_names(),
                env=env,
            )

        pytest_args = ["-q", "-rs"]
        if mode == "fast":
            pytest_args.extend(["-m", "not full"])
        elif mode == "e2e":
            pytest_args.extend(["-k", "live"])
        elif mode == "stress":
            pytest_args.extend(["-k", "mutation or fuzz or verifier or service"])
        run("Python and marimo contracts", sys.executable, "-m", "pytest", *pytest_args, env=env)

    verify_generated_artifact_hygiene(artifact_baseline, baseline_tracked=tracked_artifacts)
    print("Generated-artifact hygiene passed.", flush=True)

    print(f"\nGraphimo {mode} verification passed.", flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
