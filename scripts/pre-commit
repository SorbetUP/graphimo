#!/usr/bin/env python3
"""Pre-commit gate: validate the exact staged snapshot before a commit is allowed.

The gate runs on the index content (``git write-tree``), never on the dirty
worktree, and its result is cached by tree hash: re-committing the same staged
snapshot (e.g. after ``--amend`` with no content change) is free.
"""

from __future__ import annotations

import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    staged = subprocess.run(
        ["git", "diff", "--cached", "--quiet"], cwd=ROOT, check=False
    ).returncode
    if staged == 0:
        return 0  # nothing staged

    tree = subprocess.run(
        ["git", "write-tree"], cwd=ROOT, capture_output=True, text=True, check=True
    ).stdout.strip()
    ruff = subprocess.run(
        ["ruff", "--version"], capture_output=True, text=True, check=False
    ).stdout.strip()
    fingerprint = hashlib.sha256(f"{tree}\n{ruff}\n{sys.version}".encode("utf-8")).hexdigest()

    git_dir = Path(
        subprocess.run(
            ["git", "rev-parse", "--git-dir"], cwd=ROOT, capture_output=True, text=True, check=True
        ).stdout.strip()
    )
    if not git_dir.is_absolute():
        git_dir = ROOT / git_dir
    cache_path = git_dir / "graphimo-pre-commit-cache.json"
    try:
        cache = json.loads(cache_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        cache = {}
    if cache.get("fingerprint") == fingerprint and cache.get("result") == "ok":
        print(f"pre-commit: staged snapshot {tree[:12]} already validated, skipping gate.")
        return 0

    print(f"pre-commit: validating staged snapshot {tree[:12]} with scripts/check --fast ...")
    result = subprocess.run([sys.executable, str(ROOT / "scripts" / "check"), "--fast"], cwd=ROOT)
    if result.returncode != 0:
        print("pre-commit: gate failed; commit refused.", file=sys.stderr)
        return result.returncode
    cache = {"fingerprint": fingerprint, "tree": tree, "result": "ok"}
    try:
        cache_path.write_text(json.dumps(cache), encoding="utf-8")
    except OSError:
        pass
    print("pre-commit: staged snapshot validated.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
