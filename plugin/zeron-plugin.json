{
  "id": "graphimo",
  "name": "Graphimo",
  "version": "0.3.0",
  "description": "A live canvas view over marimo notebooks.",
  "entry": "init.luau",
  "icon": "graphimo.svg",
  "permissions": [
    "pages.add",
    "tools",
    "commands",
    "links.open",
    "files",
    "clipboard"
  ],
  "commands": [
    "curl",
    "python3"
  ],
  "tools": [
    {
      "name": "inspect",
      "description": "Inspect the live cells and dependencies of the selected marimo notebook.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "list_components",
      "description": "List public callables in the selected notebook project's components folder.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "add_component",
      "description": "Insert a readable Python cell calling a selected component.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "callable": {
            "type": "string"
          },
          "output_name": {
            "type": "string"
          },
          "bindings": {
            "type": "object"
          }
        },
        "required": [
          "component_id",
          "callable",
          "output_name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "connect",
      "description": "Safely replace one simple component call input with an upstream variable or a specific output port.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "from_cell_id": {
            "type": "string"
          },
          "variable": {
            "type": "string"
          },
          "output_index": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based index of the source node's output port when it has several outputs."
          },
          "to_cell_id": {
            "type": "string"
          },
          "input_ref": {
            "type": "string"
          }
        },
        "required": [
          "from_cell_id",
          "variable",
          "to_cell_id",
          "input_ref"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "run",
      "description": "Ask the active marimo session to run one cell.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          }
        },
        "required": [
          "cell_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "open_code",
      "description": "Open the corresponding notebook in marimo's editor.",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "cell_id": {
            "type": "string"
          }
        },
        "required": [
          "cell_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_inspect",
      "description": "Inspect the selected project's Graphimo scope, groups, components, MetaBlocks and live marimo notebook.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "session_id": {
            "type": "string",
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_execute",
      "description": "Execute one GraphimoApplication action for the selected project.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_group_from_selection",
      "description": "Create a reusable Group Block from 2-128 live marimo cells, infer crossing inputs and outputs in Graphimo Core, and replace the selected cells after source-hash validation.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "session_id": {
            "type": "string",
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "module": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "selected_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "required": [
          "name",
          "module",
          "selected_ids"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_execute_batch",
      "description": "Execute an ordered batch of GraphimoApplication actions with result references and a per-step journal.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "object"
            }
          },
          "continue_on_error": {
            "type": "boolean"
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_component_write",
      "description": "Create or update a reusable @node Python component after bounded validation.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "component_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          }
        },
        "required": [
          "component_path",
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_validate",
      "description": "Validate a reusable @node component and return Graphimo contract diagnostics.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "component_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "component_path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "graphimo_events",
      "description": "Read bounded Graphimo application and addon events after a cursor.",
      "input": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "cursor": {
            "type": "string",
            "maxLength": 32
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 256
          },
          "wait_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
